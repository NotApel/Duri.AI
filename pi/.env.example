# Pi-only settings. No database, Supabase, JWT or shared device secrets belong here.
PI_API_URL=https://your-api.onrender.com
PI_GATEWAY_CREDENTIAL=replace-with-a-provisioned-gateway-credential
PI_NODE_IDS=replace-with-assigned-node-ids
PI_OUTBOX_PATH=/var/lib/duri-ai/outbox.sqlite
# Must match the provisioned gateway. Use a separate gateway/outbox for real events.
PI_SIMULATION=true
