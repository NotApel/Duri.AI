{
  "name": "duriai-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:cloudflare": "vite build --mode cloudflare",
    "build:cloudflare:staging": "vite build --mode cloudflare-staging",
    "cf:preview": "wrangler dev --local --env=\"\"",
    "cf:deploy": "npm run build:cloudflare && wrangler deploy --env=\"\"",
    "cf:deploy:staging": "npm run build:cloudflare:staging && wrangler deploy --env staging",
    "test": "node --test tests/*.test.js pi/*.test.cjs",
    "test:browser": "node tests/priorities.browser.cjs && node tests/detectionIntegration.browser.cjs && node tests/passwordRecovery.browser.cjs && node tests/farmManagement.browser.cjs",
    "test:pwa": "node tests/cloudPwa.browser.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.12",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.8"
  }
}
