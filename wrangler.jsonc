{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duri-ai",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  "env": {
    "staging": {
      "name": "duri-ai-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "html_handling": "none"
      }
    }
  }
}
