# Public frontend values only. Copy to .env.local for local development.
VITE_API_URL=http://localhost:3000/api

# Cloudflare production: set this in Workers Builds build variables.
# VITE_API_URL=https://your-api.onrender.com/api
# Local production deploys read .env.cloudflare.local or the process environment.
# Staging deploys read .env.cloudflare-staging.local or their build environment.
# Each environment must use its own intended HTTPS backend URL ending in /api.
# VITE_* values are included in browser JavaScript. Never put private keys here.
