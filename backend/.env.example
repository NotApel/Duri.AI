# Copy to backend/.env only if you do not already have local configuration.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=duri_ai_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-database-password
PORT=3000
# Comma-separated exact frontend origins; localhost and 127.0.0.1 are distinct.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a unique secret (32 or more random bytes recommended).
JWT_SECRET=replace-with-a-long-random-secret
# Device API key is required for ESP32/device endpoints.
DEVICE_API_KEY=replace-with-a-separate-device-key
# Serve production frontend/API over HTTPS.
NODE_ENV=development

# Password-reset email. Set a trusted frontend origin; never derive it from Host.
FRONTEND_URL=http://localhost:5173
# Fill these with your SMTP provider details. Blank host/from disables recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Heartbeats older than this are shown as OFFLINE (seconds).
NODE_OFFLINE_AFTER_SECONDS=300
# Optional training worker. Leave blank until an actual script is installed.
PYTHON_PATH=
RETRAIN_SCRIPT_PATH=

# Supabase PostgreSQL connection URL takes precedence over DB_* fields.
# Leave blank for local development. Production requires verified TLS.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=5
# Optional trusted CA file if your database certificate needs a custom chain.
DB_SSL_CA_FILE=

# Private Supabase Storage. Service-role credentials are BACKEND ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=harvest-images

# Web Push. Enable only after configuring all three VAPID values.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-your-contact@example.com

# Weekly training uses the same configured worker as the manual button.
AUTO_RETRAIN_ENABLED=true
AUTO_RETRAIN_CRON=0 2 * * 0
