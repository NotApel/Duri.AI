# Copy to backend/.env only if you do not already have local configuration.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=duri_ai_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-database-password
PORT=3000
# Comma-separated exact frontend origins; localhost and 127.0.0.1 are distinct.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a unique secret (32 or more random bytes recommended).
JWT_SECRET=replace-with-a-long-random-secret
# Device API key is required for ESP32/device endpoints.
DEVICE_API_KEY=replace-with-a-separate-device-key
# Serve production frontend/API over HTTPS.
NODE_ENV=development
